{
  "manifest_version": 3,
  "name": "职航 · 岗位导入",
  "version": "0.2.4",
  "description": "点击采集 BOSS直聘岗位并导入本机职航；独立授权后协助填写字节校园网申。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "导入职航：读取当前岗位并预览" },
  "options_page": "preview.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4317" }
}
