# Prefer the in-app Model Settings screen; it verifies and applies changes without restart.
# Optional legacy environment configuration: all three connection fields must be set together.
# Leave all three blank to start in demonstration mode. Never commit secrets.
MODEL_API_KEY=
# DeepSeek base URL: https://api.deepseek.com
MODEL_BASE_URL=
# DeepSeek current preset: deepseek-flash (verify available models in the provider console).
MODEL_NAME=
MODEL_JSON_MODE=true
MODEL_TIMEOUT_MS=90000
PORT=4317
# Public company job discovery is enabled by default; false disables external job-source calls.
JOB_DISCOVERY_ENABLED=true
# Additional public LinkedIn/Indeed discovery. false keeps only official adapters.
# Install with scripts/setup-jobspy.ps1 (Windows) or scripts/setup-jobspy.sh.
JOBSPY_ENABLED=true
# Optional absolute Python executable with python-jobspy installed.
# Blank uses .venv-jobspy/Scripts/python.exe on Windows, .venv-jobspy/bin/python elsewhere.
# Example: C:/Path/To/Environment/Scripts/python.exe
JOBSPY_PYTHON=
